#!/usr/bin/env python3
"""Lookout's server-side helper (Linux). Lookout copies it to ~/.lookout/bin/lookout-hook.

  lookout-hook claude|codex    Hook mode: called by the agent's hooks. Appends the event to
                               ~/.lookout/events.jsonl. Never prints, never fails the agent.
  lookout-hook --watch         Run by Lookout over ssh: streams new events, plus the running
                               agents every few seconds, as JSON lines on stdout.
  lookout-hook --install       Adds hook entries to ~/.claude/settings.json and ~/.codex/hooks.json
  lookout-hook --uninstall     (timestamped backups are written next to each file).

Standard library only; works with Python 3.6+.
"""
import datetime
import glob
import hashlib
import json
import os
import sys
import time
import uuid

VERSION = 1
HOME = os.path.expanduser("~")
ROOT = os.path.join(HOME, ".lookout")
EVENTS = os.path.join(ROOT, "events.jsonl")
SELF = os.path.join(ROOT, "bin", "lookout-hook")
MARKER = "lookout-hook"
MAX_EVENTS_BYTES = 5 * 1024 * 1024
SNAPSHOT_INTERVAL = 5.0
WATCHING = os.path.join(ROOT, "watching")  # touched by --watch while Lookout is connected
DECISIONS = os.path.join(ROOT, "decisions")

CLAUDE_EVENTS = ["SessionStart", "UserPromptSubmit", "PreToolUse", "PostToolUse",
                 "PostToolUseFailure", "PermissionRequest", "Notification", "Stop", "SessionEnd",
                 "SubagentStart", "SubagentStop"]
CLAUDE_TOOL_EVENTS = {"PreToolUse", "PostToolUse", "PostToolUseFailure", "PermissionRequest"}
CODEX_EVENTS = ["SessionStart", "UserPromptSubmit", "PreToolUse", "PostToolUse",
                "PermissionRequest", "Stop", "Interrupt", "SessionEnd"]


# MARK: /proc helpers

def proc_stat(pid):
    """(ppid, tty_nr, comm) for pid, or None."""
    try:
        with open("/proc/%d/stat" % pid, "rb") as f:
            data = f.read().decode("utf-8", "replace")
    except OSError:
        return None
    comm = data[data.index("(") + 1:data.rindex(")")]
    rest = data[data.rindex(")") + 2:].split()
    return int(rest[1]), int(rest[4]), comm


def readlink(path):
    try:
        return os.readlink(path)
    except OSError:
        return ""


def cmdline(pid):
    try:
        with open("/proc/%d/cmdline" % pid, "rb") as f:
            return [a.decode("utf-8", "replace") for a in f.read().split(b"\0") if a]
    except OSError:
        return []


def environ(pid):
    try:
        with open("/proc/%d/environ" % pid, "rb") as f:
            items = f.read().split(b"\0")
    except OSError:
        return {}
    env = {}
    for item in items:
        key, sep, value = item.partition(b"=")
        if sep:
            env[key.decode("utf-8", "replace")] = value.decode("utf-8", "replace")
    return env


def ancestors(pid):
    chain = []
    while pid > 1 and len(chain) < 32:
        stat = proc_stat(pid)
        if stat is None:
            break
        chain.append(pid)
        pid = stat[0]
    return chain


def is_agent(pid, source, comm):
    """Native Claude installs run from .../claude/versions/<version>, so comm is the version."""
    if comm == source:
        return True
    exe = readlink("/proc/%d/exe" % pid)
    return os.path.basename(exe) == source or ("/%s/versions/" % source) in exe


def find_agent(source):
    pid, fallback = os.getppid(), None
    for _ in range(12):
        stat = proc_stat(pid)
        if pid <= 1 or stat is None:
            break
        if is_agent(pid, source, stat[2]):
            return pid
        if fallback is None and stat[2] == "node":
            fallback = pid
        pid = stat[0]
    return fallback


def started_at(pid):
    """Process start as a Unix timestamp (/proc/<pid>/stat field 22 is in clock ticks since boot)."""
    try:
        with open("/proc/%d/stat" % pid, "rb") as f:
            data = f.read().decode("utf-8", "replace")
        ticks = int(data[data.rindex(")") + 2:].split()[19])
        with open("/proc/stat") as f:
            btime = next(int(line.split()[1]) for line in f if line.startswith("btime "))
        return btime + ticks / os.sysconf("SC_CLK_TCK")
    except (OSError, ValueError, IndexError, StopIteration):
        return None


def git_branch(directory):
    """Branch of the repository containing directory (short commit when detached), from .git/HEAD."""
    d = directory
    for _ in range(32):
        dot_git = os.path.join(d, ".git")
        if os.path.exists(dot_git):
            git_dir = dot_git
            try:
                if os.path.isfile(dot_git):  # worktree
                    with open(dot_git) as f:
                        line = f.readline().strip()
                    if not line.startswith("gitdir:"):
                        return None
                    git_dir = os.path.join(d, line[len("gitdir:"):].strip())
                with open(os.path.join(git_dir, "HEAD")) as f:
                    head = f.read().strip()
            except OSError:
                return None
            if head.startswith("ref: refs/heads/"):
                return head[len("ref: refs/heads/"):]
            return head[:7] if len(head) >= 7 else None
        parent = os.path.dirname(d)
        if not d or parent == d:
            return None
        d = parent
    return None


def process_context(pid, env=None):
    """Where an agent runs: its tty, ancestors and the ssh/terminal it came through."""
    env = environ(pid) if env is None else env
    tty = readlink("/proc/%d/fd/0" % pid)
    ctx = {
        "agentPID": pid,
        "ancestors": ancestors(pid),
        "tty": tty if tty.startswith(("/dev/pts/", "/dev/tty")) else None,  # not /dev/null
        "term": env.get("TERM"),
        "termProgram": env.get("TERM_PROGRAM"),
        "startedAt": started_at(pid),
    }
    parts = env.get("SSH_CONNECTION", "").split()
    if len(parts) == 4 and parts[1].isdigit():
        ctx["sshClientPort"] = int(parts[1])
    return ctx


# MARK: Hook mode

def codex_session_name(session_id):
    """Codex's thread name from ~/.codex/session_index.jsonl (the last line for an id wins)."""
    if not session_id:
        return None
    try:
        with open(os.path.join(HOME, ".codex", "session_index.jsonl"), "rb") as f:
            lines = f.read().splitlines()
    except OSError:
        return None
    for raw in reversed(lines):
        if session_id.encode() not in raw:
            continue
        try:
            entry = json.loads(raw.decode("utf-8", "replace"))
        except ValueError:
            continue
        if entry.get("id") == session_id:
            name = (entry.get("thread_name") or "").strip()
            return name or None
    return None


def hook(source):
    payload = json.loads(sys.stdin.buffer.read().decode("utf-8", "replace"))
    if not isinstance(payload, dict):
        return
    payload.pop("tool_response", None)
    tool_input = payload.get("tool_input")
    full_input = json.loads(json.dumps(tool_input)) if isinstance(tool_input, dict) else {}  # an answer goes back with all of it
    if isinstance(tool_input, dict):
        for key, value in list(tool_input.items()):
            limit = 64 * 1024 if key == "plan" else 300  # Lookout shows the whole plan (PlanReview.maxLength)
            if isinstance(value, str) and len(value) > limit:
                tool_input[key] = value[:limit]
            elif not isinstance(value, (str, int, float, bool)) and key != "questions":
                del tool_input[key]

    agent = find_agent(source)
    context = process_context(agent, dict(os.environ)) if agent else {}
    context["timestamp"] = time.time()
    if payload.get("cwd"):
        context["branch"] = git_branch(payload["cwd"])
    if source == "codex":
        name = codex_session_name(payload.get("session_id"))
        if name:
            context["sessionName"] = name
    decision_id = None
    if source == "claude" and payload.get("hook_event_name") == "PermissionRequest" and lookout_connected():
        decision_id = uuid.uuid4().hex
        context["decisionID"] = decision_id
    line = json.dumps({"source": source, "context": context, "payload": payload}) + "\n"

    ensure_private()
    try:
        if os.path.getsize(EVENTS) > MAX_EVENTS_BYTES:
            open(EVENTS, "w").close()
    except OSError:
        pass
    fd = os.open(EVENTS, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
    try:
        os.write(fd, line.encode("utf-8"))  # one O_APPEND write per event
    finally:
        os.close(fd)
    if decision_id:
        await_decision(decision_id, full_input, payload.get("tool_name"))


def lookout_connected():
    try:
        return time.time() - os.path.getmtime(WATCHING) < 3 * SNAPSHOT_INTERVAL
    except OSError:
        return False


def await_decision(decision_id, full_input, tool_name):
    """Waits for Allow, Deny or answers to Claude's questions from Lookout, which writes it to ~/.lookout/decisions/<id> over ssh, or "none"
    once the request was answered in the terminal (whose dialog stays usable meanwhile). Prints the decision
    for Claude Code as the Mac's hook does (PermissionDecision.swift)."""
    os.makedirs(DECISIONS, mode=0o700, exist_ok=True)
    for name in os.listdir(DECISIONS):  # answers for hooks that had already given up
        try:
            if time.time() - os.path.getmtime(os.path.join(DECISIONS, name)) > 3600:
                os.remove(os.path.join(DECISIONS, name))
        except OSError:
            pass
    path = os.path.join(DECISIONS, decision_id)
    deadline = time.time() + 590  # under Claude's 600 s hook timeout
    while time.time() < deadline and lookout_connected():
        try:
            with open(path) as f:
                answer = f.read().strip()
        except OSError:
            time.sleep(0.5)
            continue
        try:
            os.remove(path)
        except OSError:
            pass
        head, _, rest = answer.partition("\n")
        decision = None
        if head in ("allow", "deny"):
            decision = {"behavior": head}
            if head == "deny":
                decision["message"] = "Denied from Lookout"
        elif head == "feedback" and rest.strip():
            decision = {"behavior": "deny", "message": rest.strip()}
        elif head == "answer" and tool_name == "AskUserQuestion":  # an answer allows with changed input
            try:
                answers = json.loads(rest)
            except ValueError:
                answers = None
            if isinstance(answers, dict) and all(isinstance(v, str) for v in answers.values()):
                updated = dict(full_input)
                updated["answers"] = answers
                decision = {"behavior": "allow", "updatedInput": updated}
        if decision:
            sys.stdout.write(json.dumps({"hookSpecificOutput": {"hookEventName": "PermissionRequest", "decision": decision}}))
        return


# MARK: Watch mode

def alive(pid):
    return os.path.exists("/proc/%d" % pid)


def claude_agents():
    agents = []
    for path in glob.glob(os.path.join(HOME, ".claude", "sessions", "*.json")):
        try:
            with open(path) as f:
                session = json.load(f)
            pid = int(session["pid"])
        except (OSError, ValueError, KeyError, TypeError):
            continue
        exe = readlink("/proc/%d/exe" % pid)
        if not alive(pid) or ("claude" not in exe and "claude" not in " ".join(cmdline(pid))):
            continue  # stale file, or PID reused
        record = {k: session.get(k) for k in
                  ("sessionId", "cwd", "status", "waitingFor", "kind", "name", "statusUpdatedAt")}
        record.update(process_context(pid))
        record["source"] = "claude"
        record["branch"] = git_branch(record.get("cwd") or "")
        agents.append(record)
    return agents


def codex_agents():
    """Interactive Codex CLIs: native `codex` processes attached to a terminal."""
    agents = []
    for entry in os.listdir("/proc"):
        if not entry.isdigit():
            continue
        pid = int(entry)
        stat = proc_stat(pid)
        if stat is None or stat[2] != "codex" or stat[1] == 0:
            continue
        cwd = readlink("/proc/%d/cwd" % pid)
        if not cwd:
            continue
        record = process_context(pid)
        record.update({"source": "codex", "cwd": cwd, "branch": git_branch(cwd)})
        agents.append(record)
    return agents


def emit(message):
    sys.stdout.write(json.dumps(message) + "\n")
    sys.stdout.flush()


def recent_agent_pids():
    """Agent PIDs from recent events, so sessions seen before a reconnect keep their liveness."""
    pids = set()
    try:
        with open(EVENTS, "rb") as f:
            f.seek(0, os.SEEK_END)
            f.seek(max(0, f.tell() - 1024 * 1024))
            for line in f.read().splitlines():
                try:
                    pid = json.loads(line.decode("utf-8", "replace"))["context"]["agentPID"]
                    pids.add(int(pid))
                except (ValueError, KeyError, TypeError):
                    pass
    except OSError:
        pass
    return pids


def hooks_installed():
    result = {}
    for source, path in (("claude", os.path.join(HOME, ".claude", "settings.json")),
                         ("codex", os.path.join(HOME, ".codex", "hooks.json"))):
        try:
            with open(path) as f:
                result[source] = MARKER in f.read()
        except OSError:
            result[source] = False
    return result


def ensure_private():
    """~/.lookout and events.jsonl hold prompts and commands: owner-only, also on older installs."""
    os.makedirs(ROOT, mode=0o700, exist_ok=True)
    os.chmod(ROOT, 0o700)
    fd = os.open(EVENTS, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
    os.fchmod(fd, 0o600)
    os.close(fd)


def watch():
    ensure_private()
    seen = recent_agent_pids()
    events = open(EVENTS, "rb")
    events.seek(0, os.SEEK_END)
    partial = b""
    with open(os.path.realpath(__file__), "rb") as f:
        sha256 = hashlib.sha256(f.read()).hexdigest()  # lets Lookout replace an outdated helper
    emit({"type": "hello", "version": VERSION, "home": HOME, "sha256": sha256, "hooks": hooks_installed()})
    next_snapshot = 0.0
    while True:
        if os.path.getsize(EVENTS) < events.tell():  # rotated by a hook
            events.seek(0)
            partial = b""
        chunk = events.read()
        if chunk:
            lines = (partial + chunk).split(b"\n")
            partial = lines.pop()
            for line in lines:
                try:
                    envelope = json.loads(line.decode("utf-8", "replace"))
                except ValueError:
                    continue
                pid = envelope.get("context", {}).get("agentPID")
                if isinstance(pid, int):
                    seen.add(pid)
                emit({"type": "event", "envelope": envelope})
        now = time.time()
        if now >= next_snapshot:
            with open(WATCHING, "a"):
                os.utime(WATCHING)  # permission hooks wait for an answer only while this is fresh
            agents = claude_agents() + codex_agents()
            seen = {pid for pid in seen if alive(pid)}
            emit({"type": "agents", "agents": agents,
                  "alive": sorted(seen | {a["agentPID"] for a in agents})})
            next_snapshot = now + SNAPSHOT_INTERVAL
        time.sleep(0.25)


# MARK: Install / uninstall

def read_json(path):
    try:
        with open(path) as f:
            text = f.read()
    except OSError:
        return {}
    if not text.strip():
        return {}
    data = json.loads(text)
    if not isinstance(data, dict):
        raise ValueError("%s is not a JSON object" % path)
    return data


def write_json(data, path):
    path = os.path.realpath(path)  # keep dotfile symlinks intact
    os.makedirs(os.path.dirname(path), exist_ok=True)
    mode = None
    if os.path.exists(path):
        mode = os.stat(path).st_mode & 0o777
        stamp = datetime.datetime.now().strftime("%Y-%m-%dT%H-%M-%S")
        with open(path, "rb") as src, open("%s.lookout-backup-%s" % (path, stamp), "wb") as dst:
            dst.write(src.read())  # owner-only via the umask: settings can hold tokens
    tmp = path + ".lookout-tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2)
        f.write("\n")
    if mode is not None:
        os.chmod(tmp, mode)  # keep the original file's permissions
    os.replace(tmp, path)


def is_lookout(entry):
    return isinstance(entry, dict) and MARKER in str(entry.get("command", ""))


def removing_lookout(hooks):
    result = {}
    for event, groups in hooks.items():
        if not isinstance(groups, list):
            result[event] = groups
            continue
        kept = []
        for group in groups:
            entries = group.get("hooks") if isinstance(group, dict) else None
            if not isinstance(entries, list):
                kept.append(group)
                continue
            remaining = [e for e in entries if not is_lookout(e)]
            if entries and not remaining:
                continue
            group = dict(group, hooks=remaining)
            kept.append(group)
        if kept:
            result[event] = kept
    return result


def adding_lookout(hooks, events, command, matcher_events):
    result = removing_lookout(hooks)
    for event in events:
        # A permission request waits up to 590 s for an answer from Lookout.
        timeout = 600 if event == "PermissionRequest" else 10
        group = {"hooks": [{"type": "command", "command": command, "timeout": timeout}]}
        if event in matcher_events:
            group["matcher"] = "*"
        result[event] = list(result.get(event, [])) + [group]
    return result


def targets():
    return [
        ("claude", os.path.join(HOME, ".claude"), os.path.join(HOME, ".claude", "settings.json"),
         CLAUDE_EVENTS, CLAUDE_TOOL_EVENTS),
        ("codex", os.path.join(HOME, ".codex"), os.path.join(HOME, ".codex", "hooks.json"),
         CODEX_EVENTS, set()),
    ]


def install():
    result = {"home": HOME, "installed": [], "errors": {}}
    for source, directory, path, events, matcher_events in targets():
        if not os.path.isdir(directory):
            continue
        try:
            root = read_json(path)
            root["hooks"] = adding_lookout(root.get("hooks") or {}, events, "%s %s" % (SELF, source), matcher_events)
            write_json(root, path)
            result["installed"].append(source)
        except (OSError, ValueError) as e:
            result["errors"][source] = str(e)
    result["codexHooksFile"] = os.path.realpath(os.path.join(HOME, ".codex", "hooks.json"))
    print(json.dumps(result))


def uninstall():
    result = {"removed": [], "errors": {}}
    for source, _directory, path, _events, _matchers in targets():
        if not os.path.exists(path):
            continue
        try:
            root = read_json(path)
            hooks = removing_lookout(root.get("hooks") or {})
            if hooks:
                root["hooks"] = hooks
            else:
                root.pop("hooks", None)
            write_json(root, path)
            result["removed"].append(source)
        except (OSError, ValueError) as e:
            result["errors"][source] = str(e)
    print(json.dumps(result))


# MARK: Transcript mode

def transcript_file(source, session_id, pid, cwd, started):
    """The agent's transcript, found the same way Lookout does on the Mac (Transcript.swift)."""
    if source == "claude":
        return next(iter(glob.glob(os.path.join(HOME, ".claude", "projects", "*", session_id + ".jsonl"))), None)
    rollouts = glob.glob(os.path.join(HOME, ".codex", "sessions", "**", "*.jsonl"), recursive=True)
    if not session_id.startswith("pid:"):
        return next((f for f in rollouts if session_id in os.path.basename(f)), None)
    # No hook yet: the rollout Codex holds open, or else the newest one for the same folder.
    if pid:
        try:
            for fd in os.listdir("/proc/%d/fd" % pid):
                target = readlink("/proc/%d/fd/%s" % (pid, fd))
                if "/.codex/sessions/" in target and target.endswith(".jsonl"):
                    return target
        except OSError:
            pass
    timed = []
    for f in rollouts:
        try:
            timed.append((os.path.getmtime(f), f))
        except OSError:
            pass
    for mtime, f in sorted(timed, reverse=True):
        if mtime < started:
            break
        try:
            with open(f, "rb") as handle:
                meta = json.loads(handle.readline().decode("utf-8", "replace"))
            if meta.get("payload", {}).get("cwd") == cwd:
                return f
        except (OSError, ValueError, AttributeError):
            pass
    return None


def is_conversation(source, entry):
    """Lines that can hold a prompt, a reply or a tool call, so tool output isn't sent over ssh."""
    if source == "codex":
        return entry.get("type") == "event_msg"
    if entry.get("type") not in ("user", "assistant") or entry.get("isMeta") or entry.get("isSidechain"):
        return False
    content = (entry.get("message") or {}).get("content")
    return isinstance(content, str) or any(
        isinstance(b, dict) and b.get("type") in ("text", "tool_use") for b in content or [])


SUMMARY_KEYS = ("command", "file_path", "path", "url", "pattern", "description")  # Transcript.toolSummary


def slim(source, entry):
    """Just what Lookout shows: no file contents, diffs or command output, and texts cut short."""
    cut = lambda text: text[:4000] if isinstance(text, str) else text
    keep = lambda d, keys: {k: d[k] for k in keys if k in d}
    if source == "codex":
        payload = dict(entry.get("payload") or {})
        if isinstance(payload.get("message"), str):
            payload["message"] = cut(payload["message"])
        item = payload.get("item")
        if isinstance(item, dict):
            item = keep(item, ("type", "content", "parsed_cmd", "command", "changes"))
            if isinstance(item.get("changes"), dict):
                item["changes"] = {path: {} for path in item["changes"]}
            if isinstance(item.get("content"), list):
                item["content"] = [{"text": cut(c.get("text"))} for c in item["content"] if isinstance(c, dict)]
            payload["item"] = item
        return {"type": entry.get("type"), "timestamp": entry.get("timestamp"), "payload": payload}
    message = entry.get("message") or {}
    content = message.get("content")
    if isinstance(content, str):
        content = cut(content)
    else:
        blocks = []
        for b in content or []:
            if not isinstance(b, dict):
                continue
            if b.get("type") == "text":
                blocks.append({"type": "text", "text": cut(b.get("text"))})
            elif b.get("type") == "tool_use":
                blocks.append({"type": "tool_use", "name": b.get("name"), "input": keep(b.get("input") or {}, SUMMARY_KEYS)})
        content = blocks
    return {"type": entry.get("type"), "timestamp": entry.get("timestamp"), "message": {"content": content}}


def transcript(source, session_id, pid, cwd, started, limit=200):
    """Prints the last `limit` conversation lines, slimmed, as "<byte offset>\\t<json>", oldest first.
    Reads backwards a chunk at a time, up to 32 MB, skipping lines over 256 KB."""
    path = transcript_file(source, session_id, pid, cwd, started)
    if not path:
        return
    chunk, max_bytes, max_line = 1 << 20, 32 << 20, 256 << 10
    found = []
    with open(path, "rb") as f:
        f.seek(0, os.SEEK_END)
        offset, read, partial = f.tell(), 0, b""
        while offset > 0 and read < max_bytes and len(found) < limit:
            size = min(chunk, offset)
            offset -= size
            f.seek(offset)
            data = f.read(size) + partial
            read += size
            parts = data.split(b"\n")
            start = offset
            if offset > 0:  # the first part began in an earlier chunk
                partial = parts.pop(0)
                start += len(partial) + 1
            else:
                partial = b""
            positions = []
            for part in parts:
                positions.append((start, part))
                start += len(part) + 1
            for line_offset, part in reversed(positions):
                if not part or len(part) > max_line:
                    continue
                try:
                    entry = json.loads(part.decode("utf-8", "replace"))
                except ValueError:
                    continue
                if isinstance(entry, dict) and is_conversation(source, entry):
                    found.append((line_offset, slim(source, entry)))
    for line_offset, entry in reversed(found[:limit]):
        sys.stdout.write("%d\t%s\n" % (line_offset, json.dumps(entry)))
    try:
        sys.stdout.write("usage\t%s\n" % json.dumps(token_usage(source, path)))
    except OSError:
        pass


# MARK: Token usage

USAGE_CACHE = os.path.join(ROOT, "usage2")  # "usage" held totals without the per-model split


def token_usage(source, path):
    """Token totals for a transcript, counted as on the Mac (TokenUsage.swift), plus per-model totals
    the Mac prices. The totals and the offset read up to are cached in ~/.lookout/usage2, so each call
    reads only what was appended since."""
    cache = os.path.join(USAGE_CACHE, hashlib.sha256(path.encode()).hexdigest() + ".json")
    empty = {"offset": 0, "last_id": None, "model": None,
             "usage": {"input": 0, "cache_read": 0, "cache_write": 0, "output": 0, "models": {}}}
    try:
        with open(cache) as f:
            state = json.load(f)
    except (OSError, ValueError):
        state = empty
    with open(path, "rb") as f:
        f.seek(0, os.SEEK_END)
        if not isinstance(state, dict) or not isinstance(state.get("offset"), int) or f.tell() < state["offset"]:
            state = empty  # unreadable cache, or the file was rewritten
        f.seek(state["offset"])
        for line in f:
            if not line.endswith(b"\n"):
                break  # still being written
            state["offset"] += len(line)
            add_usage(source, line, state)
    os.makedirs(USAGE_CACHE, mode=0o700, exist_ok=True)
    tmp = cache + ".tmp"
    with open(tmp, "w") as f:
        json.dump(state, f)
    os.replace(tmp, cache)
    return state["usage"]


def add_usage(source, line, state):
    """Claude: an assistant message's usage, once per message (its content blocks' lines repeat it, one
    after another). Codex: token_count events carry running totals, priced with the turn_context model.
    Per-model totals are [input, 5m cache writes, 1h cache writes, cache reads, output]; Claude Haiku 5.5
    requests with prompts over 100K tokens are kept apart as "<model>@long", since they cost more."""
    if source == "claude":
        if not (b'"type":"assistant"' in line and b'"usage"' in line):
            return
    elif b'"token_count"' not in line and b'"turn_context"' not in line:
        return
    try:
        entry = json.loads(line)
    except ValueError:
        return
    if not isinstance(entry, dict):
        return
    num = lambda v: v if isinstance(v, int) and v > 0 else 0
    if source == "claude":
        message = entry.get("message")
        if entry.get("type") != "assistant" or not isinstance(message, dict) or not isinstance(message.get("usage"), dict):
            return
        message_id = message.get("id")
        if message_id is not None and message_id == state["last_id"]:
            return
        state["last_id"] = message_id
        u, usage = message["usage"], state["usage"]
        written = num(u.get("cache_creation_input_tokens"))
        split = u.get("cache_creation") if isinstance(u.get("cache_creation"), dict) else {}
        hour = min(written, num(split.get("ephemeral_1h_input_tokens")))
        tokens = [num(u.get("input_tokens")), written - hour, hour, num(u.get("cache_read_input_tokens")),
                  num(u.get("output_tokens"))]
        usage["input"] += tokens[0]
        usage["cache_read"] += tokens[3]
        usage["cache_write"] += written
        usage["output"] += tokens[4]
        model = message.get("model") if isinstance(message.get("model"), str) else ""
        if model == "<synthetic>":
            return
        if model.startswith("claude-haiku-5-5") and sum(tokens[:4]) > 100000:
            model += "@long"
        totals = usage["models"].setdefault(model[:100], [0, 0, 0, 0, 0])
        for i, n in enumerate(tokens):
            totals[i] += n
    else:
        payload = entry.get("payload")
        if not isinstance(payload, dict):
            return
        if entry.get("type") == "turn_context":
            state["model"] = payload.get("model") if isinstance(payload.get("model"), str) else None
            return
        info = payload.get("info") if payload.get("type") == "token_count" else None
        u = info.get("total_token_usage") if isinstance(info, dict) else None
        if not isinstance(u, dict):
            return
        cached = num(u.get("cached_input_tokens"))
        usage = {"input": max(0, num(u.get("input_tokens")) - cached), "cache_read": cached,
                 "cache_write": num(u.get("cache_write_input_tokens")), "output": num(u.get("output_tokens"))}
        model = state.get("model")
        usage["models"] = {model[:100]: [usage["input"], usage["cache_write"], 0, cached, usage["output"]]} if model else {}
        state["usage"] = usage


def main():
    os.umask(0o077)  # everything Lookout writes on the server is owner-only
    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    if arg == "--transcript" and len(sys.argv) == 7:
        source, session_id, pid, cwd, started = sys.argv[2:7]
        transcript(source, session_id, int(pid or 0), cwd, float(started or 0))
    elif arg == "--watch":
        try:
            watch()
        except (BrokenPipeError, KeyboardInterrupt):
            pass
    elif arg == "--install":
        install()
    elif arg == "--uninstall":
        uninstall()
    elif arg in ("claude", "codex"):
        try:
            hook(arg)
        except Exception:  # a hook must never break the agent
            pass
        sys.exit(0)
    else:
        sys.stderr.write(__doc__)
        sys.exit(2)


if __name__ == "__main__":
    main()
